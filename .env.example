# ----------------------------------------------------------------------
# .env.example — TEMPLATE. Do NOT put real passwords here.
#
# On the server:
#   1. Copy this to a file named ".env"
#   2. Place it ABOVE public_html  ->  /home/ragusat/.env
#      (so it can never be served over the web)
#   3. Fill in the real values below.
#
# GMAIL_APP_PASSWORD is a Google "App Password" (16 chars), NOT your normal
# Gmail login password. Create one at https://myaccount.google.com/apppasswords
# Spaces in the password are fine.
# ----------------------------------------------------------------------

GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_INBOX=Ragusatuktours@gmail.com
